# Copy to .env and adjust. Never commit .env.
# Values below are placeholders for local development only.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true only behind a reverse proxy you control (affects client IPs).
TRUST_PROXY=false

# PostgreSQL started by docker-compose (password must match POSTGRES_PASSWORD).
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://triage:change-me@localhost:5433/ticket_triage
DATABASE_POOL_MAX=10
# Optional: the test suite defaults to postgres://triage:change-me@localhost:5433/ticket_triage_test
# TEST_DATABASE_URL=

# LLM provider: "fake" (deterministic, free, no network) or "anthropic".
LLM_PROVIDER=fake
# Required only when LLM_PROVIDER=anthropic. Use a development key with a spend limit.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# low | medium | high
LLM_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_MS=20000
LLM_MAX_TRANSPORT_RETRIES=1
# Re-run a declined request on Anthropic's recommended fallback model.
# Haiku 5.5 does not support it; enable only with a model that does (e.g. claude-opus-5-5).
LLM_REFUSAL_FALLBACK=false

# Abuse and cost controls.
RATE_LIMIT_PER_MINUTE=60
# Used by `pnpm client:create` when --budget is not given.
DEFAULT_DAILY_TOKEN_BUDGET=200000
